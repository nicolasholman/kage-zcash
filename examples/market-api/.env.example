# Where payments go: the merchant's shielded address (from `kage wallet new --role merchant`)
KAGE_PAY_TO=
# Your Kage facilitator (it holds the merchant's incoming viewing key, never the seed)
KAGE_FACILITATOR_URL=http://127.0.0.1:4021
KAGE_FACILITATOR_TOKEN=
# The facilitator's receipt public key (from `kage facilitator keygen`)
KAGE_RECEIPT_PUBKEY=
PORT=4300
