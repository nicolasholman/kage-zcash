# Copy to .env and fill in. Every binary exits non-zero naming the first missing var.

# Testnet lightwalletd. https://testnet.zec.rocks:443 answered HTTP/2 200 on 2026-10-20,
# but no official Zcash doc listing it was found yet. Re-verify before the demo.
ZCASH_LWD_URL=

# Merchant (server + facilitator). The facilitator gets the viewing key ONLY, never a spend key.
X402Z_MERCHANT_UA=
X402Z_MERCHANT_UFVK=
X402Z_RECEIPT_SIGNING_KEY=
X402Z_FACILITATOR_URL=

# Agent
X402Z_AGENT_WALLET_DIR=
X402Z_TARGET_URL=
