# Copy to .env and fill in. Every binary exits non-zero naming the first missing var.

# Testnet lightwalletd (gRPC; https => TLS). Unset => https://testnet.zec.rocks:443, which served
# chain "test" (ECC LightWalletD v0.5.4) on 2026-10-20. No official Zcash doc lists it yet.
ZCASH_LWD_URL=

# Merchant (server + facilitator). The facilitator gets an INCOMING viewing key only: it sees
# payments to the merchant, never its spends or change, and it cannot spend.
X402Z_MERCHANT_UA=
# Recommended: unified incoming viewing key (uivktest1...). `x402z-facilitator derive-uivk` prints it
# from a UFVK in X402Z_MERCHANT_UFVK.
X402Z_MERCHANT_UIVK=
# Deprecated: a full viewing key (uviewtest1...) also works, with a startup warning; only its
# incoming part is kept. Set only one of the two.
# X402Z_MERCHANT_UFVK=
# Facilitator: hex ed25519 secret key (32 bytes). `x402z-facilitator keygen` prints a pair.
X402Z_RECEIPT_SIGNING_KEY=
# Facilitator bind address (default 127.0.0.1:4021). The server settles X-PAYMENT through X402Z_FACILITATOR_URL.
X402Z_FACILITATOR_BIND=
X402Z_FACILITATOR_URL=http://127.0.0.1:4021
# Facilitator + server: shared bearer token for /verify and /settle (at least 32 chars; `openssl rand -hex 32`).
# Required by both: the facilitator refuses to start without it, and answers 401 to callers without it.
X402Z_FACILITATOR_TOKEN=
# Facilitator: SQLite file of nonce -> txid bindings (default ./x402z-facilitator.sqlite).
X402Z_FACILITATOR_DB=
# Server: hex ed25519 public key of the facilitator's receipt signing key (32 bytes).
X402Z_RECEIPT_PUBKEY=
# Optional: price per request in zatoshi (default 100000 = 0.001 TAZ).
X402Z_PRICE_ZAT=
# Server public port: the paid API only (/api/quote, /api/redeem, /tab/issue, QR). Default 127.0.0.1:4020.
X402Z_BIND=
# Server admin port: dashboard, /api/events feed, /api/status (plus the API for the page). Default 127.0.0.1:4029;
# "off" disables it. Keep it on loopback: the feed is the merchant's own.
X402Z_ADMIN_BIND=
# Server admin port: extra Host values it answers to (comma-separated host:port). By default only its bind address
# and 127.0.0.1 / [::1] / localhost on its port; any other Host is a 403 (DNS-rebinding protection).
X402Z_ADMIN_HOSTS=
# Server: comma-separated IPs of reverse proxies whose X-Forwarded-For the rate limiter believes (default none).
X402Z_TRUSTED_PROXIES=
# Agent: ledger written by x402z-agent (spend caps + audit). Required to pay. Sealed at rest
# (XChaCha20-Poly1305) together with the Kage Tab token file, under X402Z_AGENT_LEDGER_KEY
# (64 hex, `openssl rand -hex 32`) or, if that is unset, a key derived from X402Z_AGENT_SEED.
# Neither => "Setup required". `x402z-agent seal-ledger` encrypts a plaintext ledger from an older version.
X402Z_AGENT_LEDGER=
X402Z_AGENT_LEDGER_KEY=
# Server, one-machine demo only: show that agent ledger in the merchant dashboard's spendguard panel,
# opened with the agent's ledger key. Unset (the default) => the panel says the payer's ledger is not shown.
# A real merchant never sets these.
X402Z_DEMO_AGENT_LEDGER=
X402Z_DEMO_AGENT_LEDGER_KEY=
# Server + facilitator: minimum confirmations before a receipt is issued / content unlocks (default 1; 0 = mempool).
X402Z_MIN_CONFIRMATIONS=
# Server + facilitator: a payment counts if its block's time is <= expiresAt + this many seconds (default 1200).
X402Z_EXPIRY_GRACE_SECS=
# Server: SQLite challenge book (default ./x402z-server.sqlite); how long after expiry an unredeemed challenge
# stays redeemable for a payment that was mined in time (default 86400 s).
X402Z_SERVER_DB=
X402Z_REDEEM_WINDOW_SECS=
# Server: the payer may present the same X-PAYMENT (memoNonce, txid) again this long after its 200 and get the
# content again, so a lost answer never looks like a refusal (default 600 s; 0 = a spent nonce is always refused).
X402Z_RESEND_WINDOW_SECS=
# Kage Tab: most blind-RSA tokens one payment can buy (default 20; 0 = tab off) and key epoch length (default 604800 s).
X402Z_TAB_MAX_TOKENS=
X402Z_TAB_EPOCH_SECS=
# Kage Tab: after its epoch, the previous key still issues tabs paid under it and accepts its tokens this long (default 1800 s).
X402Z_TAB_GRACE_SECS=
# Server: 402 challenges and payment attempts per minute per client (default 30; 0 = no limit). Excess => 429 + Retry-After.
X402Z_CHALLENGE_RATE_PER_MIN=

# Agent. Wallet = zcash_client_sqlite db in X402Z_AGENT_WALLET_DIR, synced via ZCASH_LWD_URL.
X402Z_AGENT_WALLET_DIR=
# 24-word BIP 39 phrase of a FUNDED testnet wallet, and the block height it was created at.
# Missing seed or balance => the agent exits 4 and says exactly what is missing. It never pays without them.
X402Z_AGENT_SEED=
X402Z_AGENT_BIRTHDAY=
X402Z_TARGET_URL=http://127.0.0.1:4020/api/quote
# spendguard: comma-separated hosts (exact or *.suffix; deny by default; an entry may pin a :port and a scheme://),
# daily cap (default 500000 zat), optional approval threshold (prompts on a TTY, declines otherwise), agent name
# (default agent-1). The allowlist is checked before the agent sends any request.
X402Z_AGENT_ALLOWED_HOSTS=127.0.0.1
X402Z_AGENT_DAILY_CAP_ZAT=
X402Z_AGENT_APPROVAL_ZAT=
X402Z_AGENT_NAME=
# How long to wait for the facilitator's receipt after broadcasting (default 900 s).
X402Z_AGENT_CONFIRM_TIMEOUT_SECS=
# The agent refuses plain-HTTP URLs to non-loopback hosts (an on-path attacker could rewrite payTo); 1 allows them.
X402Z_AGENT_ALLOW_HTTP=
# Largest answer body the agent reads (default 1048576 bytes).
X402Z_AGENT_MAX_BODY_BYTES=
# Kage Tab client: file holding unspent tab tokens (bearer secrets; default <X402Z_AGENT_LEDGER>.tab.json)
# and the tab size the MCP tool tab_fetch buys when none is left (default 5).
X402Z_AGENT_TAB_FILE=
X402Z_AGENT_TAB_SIZE=
