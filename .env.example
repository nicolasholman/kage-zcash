# Copy to .env and fill in. Every binary exits non-zero naming the first missing var.

# Testnet lightwalletd. https://testnet.zec.rocks:443 answered HTTP/2 200 on 2026-10-20,
# but no official Zcash doc listing it was found yet. Re-verify before the demo.
ZCASH_LWD_URL=

# Merchant (server + facilitator). The facilitator gets the viewing key ONLY, never a spend key.
X402Z_MERCHANT_UA=
X402Z_MERCHANT_UFVK=
X402Z_RECEIPT_SIGNING_KEY=
X402Z_FACILITATOR_URL=
# Server: hex ed25519 public key of the facilitator's receipt signing key (32 bytes).
X402Z_RECEIPT_PUBKEY=
# Optional: price per request in zatoshi (default 100000 = 0.001 TAZ); bind (default 127.0.0.1:4020, use 0.0.0.0:4020 for phone).
X402Z_PRICE_ZAT=
X402Z_BIND=
# Dashboard: JSON ledger written by x402z-agent (spend caps + audit). Missing => red banner.
X402Z_AGENT_LEDGER=
# Server: minimum confirmations a receipt must report before content unlocks (default 1; 0 = mempool).
X402Z_MIN_CONFIRMATIONS=

# Agent
X402Z_AGENT_WALLET_DIR=
X402Z_TARGET_URL=
